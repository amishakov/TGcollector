# Telegram API credentials from https://my.telegram.org/auth
TG_E2E_API_ID=
TG_E2E_API_HASH=

# One or more public channel usernames, separated by commas (without @).
TG_E2E_CHANNELS=

# Optional assertions and labels.
TG_E2E_FOLDER_NAME=
TG_E2E_JOB_NAME=E2E Job

# Set to 1 only when you intentionally want to run the remote logout test.
# It invalidates .auth/auth-state.json and requires a new QR/2FA login next run.
TG_E2E_VERIFY_LOGOUT=0
